# Copy to `.env` in the repository root. Restart after changing values.

# Required: Salesforce External Client App credentials.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional Salesforce settings.
# SF_LOGIN_URL=https://login.salesforce.com
# SF_OAUTH_SCOPE=
# SF_API_VERSION=62.0

# Server. Production requires a random SESSION_SECRET of at least 32 characters.
PORT=3000
SESSION_SECRET=
# APP_URL=http://localhost:3000
# NODE_ENV=development
# ORGLOOM_CANVAS_ONLY=1

# Storage. SQLite is used by default; set DATABASE_URL for PostgreSQL.
# DATABASE_URL=sqlite:./data/orgloom.db
# DATABASE_URL=postgres://user:pass@host:5432/orgloom

# Optional AI generation. Leave blank to disable it.
ANTHROPIC_API_KEY=

# Optional product analytics. Leave POSTHOG_KEY blank to disable analytics.
# POSTHOG_KEY=
# POSTHOG_HOST=https://app.posthog.com
