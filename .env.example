# Org Loom Canvas — example environment configuration.
# Copy this to `.env` in the repo root and fill in the values.
# All vars are read once at boot — changes require a server restart.

# ----- Required: Salesforce External Client App ----------------------------
#
# Created once in some SF org's Setup → External Client App Manager →
# New External Client App. (Salesforce renamed Connected Apps to
# External Client Apps in Summer '24; older orgs may still surface
# the legacy App Manager / New Connected App path — that also works.)
# See README.md for the step-by-step. The first-boot setup wizard at
# /setup will paste these in for you on the first visit if they're unset.
#
# SF_CALLBACK_URL must match what you put in the External Client App's
# "Callback URL" field exactly. The default is correct for a localhost
# install on port 3000.

SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_CALLBACK_URL=http://localhost:3000/auth/callback

# Salesforce REST/UI-API version. Pinned on every jsforce Connection we
# build. jsforce's library default ('50.0') predates UI API features
# like /ui-api/lookups?searchType=Search, so leaving this unset would
# break Lightning-style lookup typeahead. Bump in step with your
# target orgs' API version (Salesforce supports the latest 3 years).
# SF_API_VERSION=62.0

# ----- Optional: AI Generate ----------------------------------------------
#
# Set to enable the AI Generate feature. You pay Anthropic directly for
# usage; configure spend limits in your Anthropic console. Without this
# key, the AI button in the canvas is disabled (the rest of the app
# works normally).

ANTHROPIC_API_KEY=

# ----- Optional: Server ---------------------------------------------------

# Listening port. Default 3000. If you change this, update SF_CALLBACK_URL
# above AND the callback URL registered in your SF Connected App to match.
PORT=3000

# APP_URL: the public URL of this instance. Used to build absolute URLs
# for magic-link emails (n/a in canvas-standalone, but the variable
# stays for forward-compat). Defaults to http://localhost:${PORT}.
# APP_URL=http://localhost:3000

# Express session signing secret. Generate a random 32-char string for
# production. Falls back to a dev-only constant if unset — DO NOT run
# production without setting this.
SESSION_SECRET=

# ----- Optional: Database -------------------------------------------------
#
# By default Org Loom Canvas uses SQLite at ./data/orgloom.db — zero
# setup, fine for self-host. For Postgres deployment, set DATABASE_URL.

# DATABASE_URL=postgres://user:pass@host:5432/orgloom

# ----- Optional: Canvas-standalone mode -----------------------------------
#
# In the monorepo, the entry point at apps/saas/src/server.js
# conditionally skips the saas-side providers when this is set. A future
# canvas-only build won't need this flag because the saas package won't
# be present at all.

# ORGLOOM_CANVAS_ONLY=1

# ----- Optional: LAN exposure --------------------------------------------
#
# By default the server binds to localhost only. No Salesforce credentials
# are persisted — we don't request refresh_token / offline_access scopes,
# and access tokens live only in the active session. The real LAN-exposure
# risk is the single-account model: any machine on your network that
# reaches the server can OAuth in and end up sharing the same local
# account (so they see your canvases, audit log, and could connect their
# own SF orgs to your account). The first-boot setup wizard is also
# reachable until SF_CLIENT_ID is set. To expose Org Loom Canvas to a
# trusted LAN intentionally, set both vars below.
#
# ORGLOOM_PASSWORD: shared password every LAN user must enter at first
# visit. NOT a substitute for proper auth — only safe on a trusted
# network. NEVER expose to the public internet without putting Org Loom
# Canvas behind your own auth proxy.

# ORGLOOM_TRUST_NETWORK=1
# ORGLOOM_PASSWORD=

# ----- Optional: MCP token -----------------------------------------------
#
# Canvas single-tenant MCP. Set a bearer token here to allow remote AI
# clients (Claude Desktop, Cursor, ChatGPT) to talk to your local MCP
# endpoint. Leave unset to disable remote MCP entirely (the local
# Claude Desktop integration works via stdio and doesn't need this).

# ORGLOOM_MCP_TOKEN=

# ----- Optional: PostHog product analytics --------------------------------
#
# Free tier at posthog.com (1M events/mo). Project API key starts with
# `phc_`. Leave POSTHOG_KEY blank to disable analytics entirely — the
# client script becomes a no-op and no events are sent. POSTHOG_HOST
# defaults to the US cloud; set to https://eu.i.posthog.com for the EU
# region (region is permanent per project; pick at signup).
#
# Privacy posture: when set, the client snippet on signed-in canvas
# pages disables session recording and masks all text so canvas data
# never leaves the browser. Signed-out pages (landing, /pricing,
# /signup) record normally for UX debugging.

# POSTHOG_KEY=
# POSTHOG_HOST=https://app.posthog.com

# ----- Optional: Managed-package install URL ------------------------------
#
# 2GP managed-package version ID (04t...) that the saas /install-required
# page links to. When SF rejects OAuth with "External client app is not
# installed in this org," the user is redirected to /install-required
# which shows a Sandbox/Production toggle and an "Install Org Loom in
# Salesforce" button pointing at the package install page for the
# version below.
#
# Unset → /install-required falls back to a generic error and the install
# CTA is disabled. Self-host deployments that ship their own ECA don't
# need this set.

# ORGLOOM_PACKAGE_VERSION_ID=04tao000005d0TVAAY

# Canvas / upload-batch DEKs are wrapped through the installed Org Loom
# managed package (Org_Kek_Setting__c, callable only via the package's
# Apex methods). The KEK material lives in the customer's SF org and
# never leaves it. No Org Loom-side master key is configured anywhere.

# ----- Optional: Anthropic-cli for development ----------------------------
#
# Override the Anthropic API base URL (e.g. for proxying / testing).

# ANTHROPIC_BASE_URL=
